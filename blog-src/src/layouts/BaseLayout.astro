---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import { SITE, withBase } from '../lib/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  image?: string;
  tags?: string[];
  breadcrumbs?: Array<{ name: string; path: string }>;
  canonicalPath?: string;
  noindex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  type = 'website',
  publishedTime,
  modifiedTime,
  image,
  tags = [],
  breadcrumbs = [],
  canonicalPath,
  noindex = false
} = Astro.props as Props;
const pageTitle = title === SITE.title ? title : `${title} · ${SITE.shortTitle}`;
const canonical = new URL(canonicalPath ? withBase(canonicalPath) : Astro.url.pathname, Astro.site);
const socialImage = image
  ? new URL(withBase(image), Astro.site)
  : type === 'website'
    ? new URL(withBase('/assets/og-default.jpg'), Astro.site)
    : undefined;
const author = {
  '@type': 'Person',
  name: SITE.author,
  url: SITE.github
};
const primaryEntity = type === 'article'
  ? {
      '@type': 'BlogPosting',
      headline: title,
      description,
      url: canonical.toString(),
      mainEntityOfPage: canonical.toString(),
      inLanguage: 'zh-CN',
      datePublished: publishedTime,
      dateModified: modifiedTime ?? publishedTime,
      author,
      publisher: author,
      keywords: tags.join(', '),
      ...(socialImage ? { image: socialImage.toString() } : {})
    }
  : {
      '@type': 'WebSite',
      name: SITE.title,
      alternateName: SITE.shortTitle,
      description,
      url: new URL(withBase('/'), Astro.site).toString(),
      inLanguage: 'zh-CN',
      author,
      image: socialImage?.toString()
    };
const breadcrumbEntity = breadcrumbs.length > 0
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: new URL(withBase(item.path), Astro.site).toString()
      }))
    }
  : undefined;
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [primaryEntity, ...(breadcrumbEntity ? [breadcrumbEntity] : [])]
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#151020" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/atom+xml" title={SITE.title} href={withBase('/atom.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:width" content="1200" />}
    {socialImage && <meta property="og:image:height" content="630" />}
    {socialImage && <meta property="og:image:alt" content={`${SITE.title}：理解模型，驾驭 Agent。`} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === 'article' && <meta property="article:author" content={SITE.author} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
    <script is:inline>
      document.documentElement.dataset.theme = localStorage.getItem('ai-composer-theme') || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    </script>
  </head>
  <body class:list={{ 'is-post': type === 'article' }}>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="reading-progress" data-reading-progress></div>
    <div class="ambient ambient-one"></div><div class="ambient ambient-two"></div>
    <Header />
    <main id="main" class="site-main"><slot /></main>
    <Footer />
    <Search />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
