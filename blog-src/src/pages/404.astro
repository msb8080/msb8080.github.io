---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/site';
---

<BaseLayout title="页面未找到" description="请求的页面不存在。" canonicalPath="/404.html" noindex>
  <section class="not-found shell">
    <span class="eyebrow">HTTP 404</span>
    <h1>信号中断。</h1>
    <p>这个地址不存在，或者内容已经迁移。</p>
    <a class="button button-primary" href={withBase('/')}>返回首页</a>
  </section>
</BaseLayout>
