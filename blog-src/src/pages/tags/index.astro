---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { countValues, sortPosts, withBase } from '../../lib/site';

const tags = countValues(sortPosts(await getCollection('posts')), 'tags');
const popularTags = tags.filter((tag) => tag.count > 1);
const remainingTags = tags.filter((tag) => tag.count === 1);
---

<BaseLayout title="文章标签" description="通过技术关键词快速定位文章。">
  <section class="taxonomy-shell shell">
    <header class="listing-header"><span class="eyebrow">TOPIC CLOUD</span><h1>文章标签</h1><p>{tags.length} 个技术关键词，连接模型、Agent、工程化与后端架构。</p></header>
    <section class="tag-section" aria-labelledby="popular-tags-title">
      <div class="subsection-heading"><h2 id="popular-tags-title">常用标签</h2><p>优先展示收录两篇及以上文章的主题</p></div>
      <div class="tag-cloud">
        {popularTags.map((tag) => <a href={withBase(`/tags/${tag.slug}/`)}>#{tag.name}<sup>{tag.count}</sup></a>)}
      </div>
    </section>
    {remainingTags.length > 0 && (
      <details class="tag-more">
        <summary>查看其余 {remainingTags.length} 个标签</summary>
        <div class="tag-cloud">
          {remainingTags.map((tag) => <a href={withBase(`/tags/${tag.slug}/`)}>#{tag.name}<sup>{tag.count}</sup></a>)}
        </div>
      </details>
    )}
  </section>
</BaseLayout>
