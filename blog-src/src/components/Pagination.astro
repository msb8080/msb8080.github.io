---
import { withBase } from '../lib/site';

interface Props { current: number; last: number; root?: string; }
const { current, last, root = '/' } = Astro.props;
const hrefFor = (page: number) => page === 1 ? root : `${root}page/${page}/`;
---

{last > 1 && (
  <nav class="pagination" aria-label="分页">
    {current > 1 && <a href={withBase(hrefFor(current - 1))} aria-label="上一页">←</a>}
    {Array.from({ length: last }, (_, index) => index + 1).map((page) => (
      <a class:list={{ current: page === current }} aria-current={page === current ? 'page' : undefined} href={withBase(hrefFor(page))}>{page}</a>
    ))}
    {current < last && <a href={withBase(hrefFor(current + 1))} aria-label="下一页">→</a>}
  </nav>
)}
